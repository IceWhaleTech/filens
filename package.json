{
  "name": "filens-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Workspace for an ESM multi-format file preview core, Vue 3 wrapper, and demo app.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm.cmd run build:wasm && npm.cmd run build:core && npm.cmd run build:converter-client && npm.cmd run build:xlsx && npm.cmd run build:archive && npm.cmd run build:ebook && npm.cmd run build:pdf && npm.cmd run build:docx && npm.cmd run build:cad && npm.cmd run build:model3d && npm.cmd run build:mindmap && npm.cmd run build:diagram && npm.cmd run build:panorama && npm.cmd run build:iwork && npm.cmd run build:design && npm.cmd run build:media && npm.cmd run build:office && npm.cmd run build:text && npm.cmd run build:vue && npm.cmd run build:demo",
    "build:archive": "npm.cmd run build --workspace @filens/archive",
    "build:wasm": "npm.cmd run build:wasm:rust",
    "build:wasm:rust": "node ./scripts/build-converter-core-rust-wasm.mjs",
    "build:cad": "npm.cmd run build --workspace @filens/cad",
    "build:core": "npm.cmd run build --workspace @filens/core",
    "build:converter-client": "npm.cmd run build --workspace @filens/converter-client",
    "build:diagram": "npm.cmd run build --workspace @filens/diagram",
    "build:design": "npm.cmd run build --workspace @filens/design",
    "build:docx": "npm.cmd run build --workspace @filens/docx",
    "build:ebook": "npm.cmd run build --workspace @filens/ebook",
    "build:iwork": "npm.cmd run build --workspace @filens/iwork",
    "build:media": "npm.cmd run build --workspace @filens/media",
    "build:model3d": "npm.cmd run build --workspace @filens/model3d",
    "build:mindmap": "npm.cmd run build --workspace @filens/mindmap",
    "build:pdf": "npm.cmd run build --workspace @filens/pdf",
    "build:panorama": "npm.cmd run build --workspace @filens/panorama",
    "build:office": "npm.cmd run build --workspace @filens/office",
    "build:text": "npm.cmd run build --workspace @filens/text",
    "build:vue": "npm.cmd run build --workspace @filens/vue",
    "build:xlsx": "npm.cmd run build --workspace @filens/xlsx",
    "build:demo": "npm.cmd run build --workspace @filens/demo",
    "test": "npm.cmd run build && npm.cmd run test:policy && npm.cmd run test:workspaces && npm.cmd run test:go && npm.cmd run test:wasm-smoke",
    "test:workspaces": "npm.cmd run test --workspaces --if-present",
    "test:categories": "node ./scripts/check-category-packages.mjs",
    "test:go": "node ./scripts/run-go-tests.mjs wasm/converter-core examples/go-wazero-converter",
    "test:wasm": "cargo test --manifest-path wasm/converter-core-rust/Cargo.toml",
    "test:go-wazero": "node ./scripts/run-go-tests.mjs examples/go-wazero-converter",
    "test:wasm-smoke": "npm.cmd run fixtures:converter:check && node ./scripts/run-converter-fixture-smoke.mjs",
    "report:wasm-sizes": "node ./scripts/report-wasm-sizes.mjs",
    "test:unit": "npm.cmd run build:wasm && npm.cmd run test:policy && npm.cmd run test:unit --workspaces --if-present && npm.cmd run test:go && npm.cmd run test:wasm-smoke",
    "test:e2e": "playwright test",
    "test:policy": "npm.cmd run verify:conversion-policy && npm.cmd run test:audit-x2t-candidate",
    "fixtures": "node ./scripts/generate-fixtures.mjs",
    "fixtures:converter": "node ./scripts/generate-converter-fixtures.mjs",
    "fixtures:converter:check": "node ./scripts/generate-converter-fixtures.mjs --check",
    "generate:real-samples": "node ./scripts/generate-real-samples-manifest.mjs",
    "stage:real-samples": "node ./scripts/stage-real-samples.mjs",
    "verify:real-samples": "node ./scripts/verify-real-samples.mjs",
    "verify:real-sample-coverage": "node ./scripts/verify-real-sample-coverage.mjs",
    "verify:conversion-policy": "node ./scripts/verify-conversion-policy.mjs",
    "audit:real-sample-candidates": "node ./scripts/audit-real-sample-candidates.mjs",
    "audit:x2t-candidate": "node ./scripts/audit-x2t-candidate.mjs",
    "test:audit-x2t-candidate": "node ./scripts/test-audit-x2t-candidate.mjs",
    "run:real-sample-conversions": "node ./scripts/run-real-sample-conversions.mjs",
    "run:real-sample-preview": "node ./scripts/run-real-sample-preview.mjs",
    "run:real-sample-preview-strict": "node ./scripts/run-real-sample-preview-strict.mjs",
    "summarize:preview-report": "node ./scripts/summarize-preview-report.mjs",
    "summarize:real-sample-coverage": "node ./scripts/summarize-real-sample-coverage.mjs",
    "update:real-sample-expectations": "node ./scripts/update-expectations-from-strict-report.mjs",
    "run:real-samples-ci": "node ./scripts/run-real-samples-ci.mjs",
    "run:real-samples-e2e": "node ./scripts/run-real-samples-e2e.mjs",
    "proto:iwork": "node ./scripts/generate-iwork-proto.mjs",
    "test:demo": "npm.cmd run build:demo"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.15.30",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/compiler-sfc": "^3.5.17",
    "@vue/test-utils": "^2.4.6",
    "binaryen": "131.0.0",
    "jsdom": "^25.0.1",
    "protobufjs-cli": "^1.1.3",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.8",
    "vue": "^3.5.17"
  }
}

{
  "name": "filens-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Workspace for an ESM multi-format file preview core, Vue 3 wrapper, and demo app.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:agent": "node ./scripts/build-agent-cli.mjs",
    "build:agent:lite": "node ./scripts/build-agent-cli.mjs --lite",
    "setup:agent:ocr": "node ./scripts/setup-agent-ocr.mjs",
    "download:agent:models": "node ./scripts/download-agent-models.mjs",
    "filens": "node ./scripts/run-agent-cli.mjs",
    "filens:lite": "node ./scripts/run-agent-cli.mjs --lite",
    "test:agent": "node --test scripts/model-download.test.mjs && npm run build:agent && npm run build:agent:lite && cargo test --locked --manifest-path cli/Cargo.toml && node ./scripts/test-agent-cli.mjs && node ./scripts/test-agent-rust.mjs && node ./scripts/test-agent-convert.mjs",
    "test:agent:convert": "node ./scripts/test-agent-convert.mjs",
    "build": "npm run build:wasm && npm run build:core && npm run build:converter-client && npm run build:xlsx && npm run build:archive && npm run build:ebook && npm run build:pdf && npm run build:docx && npm run build:cad && npm run build:model3d && npm run build:mindmap && npm run build:diagram && npm run build:panorama && npm run build:iwork && npm run build:design && npm run build:media && npm run build:office && npm run build:text && npm run build:vue && npm run build:demo",
    "build:archive": "npm run build --workspace @filens/archive",
    "build:wasm": "npm run build:wasm:rust",
    "build:wasm:rust": "node ./scripts/build-converter-wasm.mjs",
    "build:cad": "npm run build --workspace @filens/cad",
    "build:core": "npm run build --workspace @filens/core",
    "build:converter-client": "npm run build --workspace @filens/converter-client",
    "build:diagram": "npm run build --workspace @filens/diagram",
    "build:design": "npm run build --workspace @filens/design",
    "build:docx": "npm run build --workspace @filens/docx",
    "build:ebook": "npm run build --workspace @filens/ebook",
    "build:iwork": "npm run build --workspace @filens/iwork",
    "build:media": "npm run build --workspace @filens/media",
    "build:model3d": "npm run build --workspace @filens/model3d",
    "build:occt-wasm": "node ./scripts/build-occt-wasm.mjs",
    "build:mindmap": "npm run build --workspace @filens/mindmap",
    "build:pdf": "npm run build --workspace @filens/pdf",
    "build:panorama": "npm run build --workspace @filens/panorama",
    "build:office": "npm run build --workspace @filens/office",
    "build:text": "npm run build --workspace @filens/text",
    "build:vue": "npm run build --workspace @filens/vue",
    "build:xlsx": "npm run build --workspace @filens/xlsx",
    "build:demo": "npm run build --workspace @filens/demo",
    "build:vercel": "node ./scripts/build-vercel.mjs",
    "test": "npm run build && npm run test:policy && npm run test:workspaces && npm run test:go && npm run test:wasm-smoke",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:categories": "node ./scripts/check-category-packages.mjs",
    "test:fonts:browser": "npm run build:core && npm run build:xlsx && node packages/core/test/font-loading.browser.mjs",
    "test:go": "node ./scripts/run-go-tests.mjs wasm/converter-core examples/go-wazero-converter",
    "test:wasm": "cargo test --manifest-path wasm/converter-core-rust/Cargo.toml && cargo test --manifest-path wasm/converter-image-rust/Cargo.toml && cargo test --manifest-path wasm/converter-image-rust/vendor/rawloader/Cargo.toml --lib",
    "test:occt-wasm": "node ./scripts/test-occt-wasm.mjs",
    "test:go-wazero": "node ./scripts/run-go-tests.mjs examples/go-wazero-converter",
    "test:wasm-smoke": "npm run fixtures:converter:check && node ./scripts/run-converter-fixture-smoke.mjs",
    "report:occt-wasm": "node ./scripts/report-occt-wasm.mjs",
    "report:wasm-sizes": "node ./scripts/report-wasm-sizes.mjs",
    "report:bundle-sizes": "node ./scripts/report-bundle-sizes.mjs",
    "test:unit": "npm run build:wasm && npm run test:policy && npm run test:unit --workspaces --if-present && npm run test:go && npm run test:wasm-smoke",
    "test:e2e": "playwright test",
    "test:policy": "npm run verify:conversion-policy && npm run test:audit-x2t-candidate",
    "fixtures": "node ./scripts/generate-fixtures.mjs",
    "fixtures:converter": "node ./scripts/generate-converter-fixtures.mjs",
    "fixtures:converter:check": "node ./scripts/generate-converter-fixtures.mjs --check",
    "generate:real-samples": "node ./scripts/generate-real-samples-manifest.mjs",
    "stage:real-samples": "node ./scripts/stage-real-samples.mjs",
    "verify:real-samples": "node ./scripts/verify-real-samples.mjs",
    "verify:real-sample-coverage": "node ./scripts/verify-real-sample-coverage.mjs",
    "verify:conversion-policy": "node ./scripts/verify-conversion-policy.mjs",
    "audit:real-sample-candidates": "node ./scripts/audit-real-sample-candidates.mjs",
    "audit:x2t-candidate": "node ./scripts/audit-x2t-candidate.mjs",
    "test:audit-x2t-candidate": "node ./scripts/test-audit-x2t-candidate.mjs",
    "run:real-sample-conversions": "node ./scripts/run-real-sample-conversions.mjs",
    "run:real-sample-preview": "node ./scripts/run-real-sample-preview.mjs",
    "run:real-sample-preview-strict": "node ./scripts/run-real-sample-preview-strict.mjs",
    "summarize:preview-report": "node ./scripts/summarize-preview-report.mjs",
    "summarize:real-sample-coverage": "node ./scripts/summarize-real-sample-coverage.mjs",
    "update:real-sample-expectations": "node ./scripts/update-expectations-from-strict-report.mjs",
    "run:real-samples-ci": "node ./scripts/run-real-samples-ci.mjs",
    "run:real-samples-e2e": "node ./scripts/run-real-samples-e2e.mjs",
    "proto:iwork": "node ./scripts/generate-iwork-proto.mjs",
    "test:demo": "npm run build:demo",
    "package:zimaos:filens": "npm run build --workspace @filens/demo && ./scripts/package-zimaos-filens.sh",
    "package:agent:npm": "npm run build:agent && node ./scripts/package-agent-npm.mjs --all",
    "publish:agent:npm": "node ./scripts/publish-agent-npm.mjs",
    "test:agent:npm": "node ./scripts/test-agent-npm.mjs",
    "evaluate:agent": "node ./scripts/evaluate-agent-cli.mjs",
    "evaluate:pdf-unicode": "python3 -B scripts/evaluate-pdf-unicode.py",
    "test:agent:privacy": "node --test scripts/agent-release-privacy.test.mjs && python3 -B scripts/test_pdf_unicode_privacy.py",
    "test:agent:layout": "node ./scripts/test-agent-layout.mjs",
    "demo:agent": "node ./scripts/capture-agent-cli-demo.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.15.30",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/compiler-sfc": "^3.5.17",
    "@vue/test-utils": "^2.4.6",
    "binaryen": "131.0.0",
    "jsdom": "^25.0.1",
    "protobufjs-cli": "^1.1.3",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.8",
    "vue": "^3.5.17"
  }
}

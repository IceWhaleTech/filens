{
  "name": "@filens/pdf",
  "version": "0.1.0",
  "description": "PDF preview driver for the @filens multi-format preview runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.css"
  ],
  "keywords": [
    "pdf",
    "preview",
    "viewer",
    "esm",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/rename-css.mjs ./dist style.css index.css",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "peerDependencies": {
    "@filens/core": "^0.1.0"
  },
  "devDependencies": {
    "@filens/core": "file:../core"
  },
  "dependencies": {
    "pdfjs-dist": "^5.4.624"
  }
}

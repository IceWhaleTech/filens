    "dev": "vite build --watch"
  },
  "dependencies": {
    "@filens/docx": "^0.1.0",
    "@filens/iwork": "^0.1.0",
    "@filens/pdf": "^0.1.0",
    "@filens/xlsx": "^0.1.0"
  },
  "peerDependencies": {
    "@filens/core": "^0.1.0"
  },
  "devDependencies": {
    "@filens/core": "file:../core",
    "@filens/docx": "file:../docx",
    "@filens/iwork": "file:../iwork",
    "@filens/pdf": "file:../pdf",
    "@filens/xlsx": "file:../xlsx"
  }

{
  "name": "@filens/office",
  "version": "0.1.0",
  "description": "Office, PDF, and iWork preview drivers for @filens.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",

{
  "name": "@filens/model3d",
  "version": "0.1.0",
  "description": "Browser-native 3D model preview driver for the @filens multi-format preview runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.css"
  ],
  "keywords": [
    "3d",
    "stl",
    "model",
    "three",
    "preview",
    "viewer",
    "esm",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/rename-css.mjs ./dist style.css index.css",
    "dev": "vite build --watch",
    "test": "vitest run && node ../../scripts/test-occt-wasm.mjs",
    "test:unit": "vitest run && node ../../scripts/test-occt-wasm.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "three": "^0.176.0"
  },
  "peerDependencies": {
    "@filens/core": "^0.1.0"
  },
  "devDependencies": {
    "@filens/core": "file:../core",
    "@types/three": "^0.176.0",
    "occt-import-js": "0.0.23"
  }
}
